# Backend v2 runtime. Copy this file to a local, ignored environment file and
# replace placeholders before starting Gateway.
APP_ENV=development
GATEWAY_ADDR=:8080
DATABASE_URL=postgres://agri:agri_dev@localhost:5432/agri?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
WORKER_POLL_INTERVAL=1s
WORKER_BATCH_SIZE=4
WORKER_JOB_LEASE_DURATION=5m

# Generate each secret independently; never commit the generated output:
#   openssl rand -base64 32
IDENTITY_JWT_PRIVATE_KEY_BASE64=<generate-with-openssl-rand-base64-32>
IDENTITY_OTP_PEPPER_BASE64=<generate-with-openssl-rand-base64-32>

IDENTITY_JWT_KEY_ID=identity-v1
IDENTITY_JWT_ISSUER=agri-price-crawler
IDENTITY_JWT_AUDIENCE=agri-clients
IDENTITY_JWT_ACCESS_TTL=15m
IDENTITY_REFRESH_TTL=720h
IDENTITY_REFRESH_REUSE_GRACE=10s

IDENTITY_OTP_TTL=10m
IDENTITY_OTP_ATTEMPTS=5
IDENTITY_OTP_COOLDOWN=1m
IDENTITY_OTP_EMAIL_PER_HOUR=5
IDENTITY_OTP_IP_PER_HOUR=30

# Replace both values with the mini-program credentials supplied by WeChat.
IDENTITY_WECHAT_APP_ID=<wechat-app-id>
IDENTITY_WECHAT_APP_SECRET=<wechat-app-secret>
IDENTITY_WECHAT_BASE_URL=https://api.weixin.qq.com
IDENTITY_WECHAT_TIMEOUT=5s
IDENTITY_WECHAT_IP_PER_HOUR=60

# "memory" is development-only. For SMTP, select "smtp" and configure all
# fields below. TLS modes "implicit" and "starttls" require credentials;
# unauthenticated "none" is development-only.
IDENTITY_EMAIL_DRIVER=memory
IDENTITY_SMTP_HOST=<smtp-host>
IDENTITY_SMTP_PORT=587
IDENTITY_SMTP_USERNAME=<smtp-username>
IDENTITY_SMTP_PASSWORD=<smtp-password>
IDENTITY_SMTP_FROM=<sender-mailbox>
IDENTITY_SMTP_TLS_MODE=starttls
IDENTITY_SMTP_TIMEOUT=5s

IDENTITY_ENABLED_CLIENTS=web,wechat_mini
IDENTITY_COOKIE_NAME=agri_refresh
IDENTITY_COOKIE_SECURE=false
IDENTITY_WEB_ALLOWED_ORIGINS=http://localhost:3000
IDENTITY_TRUSTED_PROXIES=
